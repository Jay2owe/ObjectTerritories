<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>31.1.0</version>
    <relativePath/>
  </parent>

  <groupId>io.github.jay2owe</groupId>
  <artifactId>Object_Territories</artifactId>
  <version>0.2.0</version>

  <name>Object Territories</name>
  <description>Bounded Voronoi territories, neighbourhood enrichment, and density maps for labelled objects in Fiji.</description>
  <url>https://github.com/Jay2owe/ObjectTerritories</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>UK Dementia Research Institute at Imperial College London</name>
    <url>https://ukdri.ac.uk/centres/imperial</url>
  </organization>

  <licenses>
    <license>
      <name>BSD 3-Clause License</name>
      <url>https://opensource.org/licenses/BSD-3-Clause</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>Jay2owe</id>
      <name>Jamie Malcolm</name>
      <url>https://github.com/Jay2owe</url>
      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>
  <contributors>
    <contributor>
      <name>Jamie Malcolm</name>
      <url>https://github.com/Jay2owe</url>
      <roles>
        <role>founder</role>
        <role>developer</role>
        <role>maintainer</role>
      </roles>
    </contributor>
  </contributors>

  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc/tag/imagej</archive>
    </mailingList>
  </mailingLists>

  <scm>
    <connection>scm:git:https://github.com/Jay2owe/ObjectTerritories</connection>
    <developerConnection>scm:git:git@github.com:Jay2owe/ObjectTerritories</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/Jay2owe/ObjectTerritories</url>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/Jay2owe/ObjectTerritories/issues</url>
  </issueManagement>
  <ciManagement>
    <system>None</system>
  </ciManagement>

  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jts.version>1.19.0</jts.version>
    <oc3d-core.version>0.1.0</oc3d-core.version>
    <territories-core.version>0.1.0</territories-core.version>
    <license.licenseName>bsd_3</license.licenseName>
    <license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
    </dependency>

    <!--
      The territory, density and interaction engine. Shaded into this JAR and
      relocated, never installed by the user as a separate artifact — see the
      shade plugin below. Compile scope, not `provided`: the class files must
      end up inside the shipped JAR, because a bare Fiji has never heard of
      territories-core and the whole point of the pattern is that it never
      has to.

      It brings JTS transitively; the explicit declaration below pins the
      same version so this plugin and the core can never resolve different
      geometry builds.
    -->
    <dependency>
      <groupId>io.github.jay2owe</groupId>
      <artifactId>territories-core</artifactId>
      <version>${territories-core.version}</version>
    </dependency>

    <dependency>
      <groupId>org.locationtech.jts</groupId>
      <artifactId>jts-core</artifactId>
      <version>${jts.version}</version>
    </dependency>

    <!--
      Shared batch-folder and regular-expression discovery. The core is
      compiled into this plugin's JAR under territories.internal.core, so Fiji
      users still install one self-contained file and cannot collide with a
      different core version embedded by another plugin.
    -->
    <dependency>
      <groupId>io.github.jay2owe</groupId>
      <artifactId>oc3d-core</artifactId>
      <version>${oc3d-core.version}</version>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>Object_Territories-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>org.locationtech.jts:jts-core</include>
                  <include>io.github.jay2owe:oc3d-core</include>
                  <include>io.github.jay2owe:territories-core</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>org.locationtech.jts</pattern>
                  <shadedPattern>territories.internal.shaded.jts</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>sc.fiji.oc3d.core</pattern>
                  <shadedPattern>territories.internal.core</shadedPattern>
                </relocation>
                <!--
                  The engine lands back on the package name it has always had
                  in the shipped JAR, deliberately, and NOT under
                  territories.internal.* .

                  territories.internal.core is already oc3d-core's landing
                  ground, so it is not available. More importantly, the engine
                  is not internal here: ObjectTerritoriesResult.getObjects(),
                  RegionAnalysisResult.getTerritories() and the rest are
                  documented public API and return these very types. Landing
                  them on territories.core keeps every published signature in
                  this JAR byte-identical to 0.2.0 — extraction moves no
                  output, including the API surface.

                  The collision rule the pattern exists to enforce still
                  holds: territories.* is this plugin's own namespace, so no
                  other JAR can carry these names. Every other consumer
                  relocates sc.fiji.territories.core into its own namespace
                  instead (Colocalization Suite uses ocs.internal.territories).
                -->
                <relocation>
                  <pattern>sc.fiji.territories.core</pattern>
                  <shadedPattern>territories.core</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>org.locationtech.jts:jts-core</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.github.jay2owe:territories-core</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>io.github.jay2owe:oc3d-core</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <!-- SCM manifest values change even when compiled classes do not. -->
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <!-- The equivalence harness reads and writes golden/pre-extraction. -->
            <territories.project.basedir>${project.basedir}</territories.project.basedir>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <territories.project.basedir>${project.basedir}</territories.project.basedir>
            <territories.project.jar>${project.build.directory}/${project.build.finalName}.jar</territories.project.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
